{
  "name": "md-ghost-align",
  "displayName": "Markdown Ghost Align",
  "description": "Aligns markdown table columns on screen with virtual padding, without writing spaces to the file.",
  "version": "0.2.2",
  "publisher": "rokartur",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdGhostAlign.fitTables",
        "title": "Markdown Ghost Align: Fit Tables to the Window"
      }
    ],
    "configurationDefaults": {
      "[markdown]": {
        "editor.inlayHints.enabled": "on",
        "editor.inlayHints.maximumLength": 0,
        "editor.inlayHints.padding": false,
        "editor.inlayHints.fontSize": 0,
        "editor.inlayHints.fontFamily": ""
      }
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rokartur/md-ghost-align.git"
  },
  "author": {
    "name": "Artur Rok",
    "email": "rokartur@icloud.com"
  },
  "keywords": [
    "markdown",
    "table",
    "align",
    "format",
    "wrap"
  ],
  "files": [
    "extension.js",
    "align.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT"
}
